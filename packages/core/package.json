    "url": "git+https://github.com/zeyadshalaby1/masar.git",
    "directory": "packages/core"
  },
  "license": "FSL-1.1-ALv2",
  "author": "Zeyad Shalaby (https://zeyadshalaby.com)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.tsx",
    "./runtime": "./src/client/runtime.ts",
    "./react": "./src/react/index.ts",
    "./admin": "./src/admin/react/index.tsx",
    "./dev-overlay": "./src/client/dev-overlay.ts"
