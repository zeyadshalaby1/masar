{
  "name": "masar-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter playground build",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "node scripts/e2e.mjs && node scripts/e2e-api.mjs",
    "start": "pnpm --filter playground start",
    "release:pack": "node scripts/pack-release.mjs",
    "release:smoke": "node scripts/smoke-release.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "playwright": "^1.64.1"
  }
}
